# =============================================================
# Velozity ProjectHub — Environment Variables
# =============================================================
# Copy this file to .env and fill in all values.
# NEVER commit .env to source control.
# =============================================================

# ── Application ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ──────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://velozity:velozity_dev_pw@localhost:5432/velozity_projecthub

# Docker Compose PostgreSQL credentials (used by docker-compose.yml)
POSTGRES_USER=velozity
POSTGRES_PASSWORD=velozity_dev_pw
POSTGRES_DB=velozity_projecthub

# ── JWT Secrets ───────────────────────────────────────────────
# Generate strong random secrets:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_use_a_long_random_string_here_for_access_token_signing
JWT_REFRESH_SECRET=CHANGE_ME_use_a_different_long_random_string_for_refresh_token_signing

# Token expiry durations (use ms/s/m/h/d notation)
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ── CORS & Client ─────────────────────────────────────────────
# Frontend URL for CORS whitelist
CLIENT_URL=http://localhost:5173

# ── Cookies ───────────────────────────────────────────────────
# Set to 'true' in production (requires HTTPS)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ── pgAdmin (Docker Compose, optional) ────────────────────────
PGADMIN_EMAIL=admin@velozity.dev
PGADMIN_PASSWORD=pgadmin_dev_pw

# ── Frontend (Vite) ───────────────────────────────────────────
# Backend API base URL (used by the React frontend)
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000
